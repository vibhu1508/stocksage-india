# Frontend Environment Variables
# Copy this file to .env for local development.
# On Vercel, set NG_APP_BACKEND in the Environment Variables section of your project settings.

# Local development:
# NG_APP_BACKEND=http://localhost:8000
# NG_APP_MARKET_WS=ws://localhost:8001   (live charts: backend/market/service.py)
# NG_APP_BRANDFETCH_CLIENT_ID=<client id> (company logos; public by design, free at developers.brandfetch.com)

# Production (Oracle Cloud backend):
NG_APP_BACKEND=https://api.stocksageindia.tech
NG_APP_MARKET_WS=wss://market.stocksageindia.tech
