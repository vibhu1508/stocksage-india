# Frontend Environment Variables
# Copy this file to .env for local development.
# On Vercel, set NG_APP_BACKEND in the Environment Variables section of your project settings.

# Local development:
# NG_APP_BACKEND=http://localhost:8000
# NG_APP_MARKET_WS=ws://localhost:8001   (live charts: backend/market/service.py)

# Production (Render backend URL):
NG_APP_BACKEND=https://stocksage-india-backend.onrender.com
