# Backend Environment Variables
# Copy this file to .env and fill in your values for local development.
# On Render, set these in the Environment section of your web service dashboard.

# Database (Render auto-sets this when linked to a PostgreSQL database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Configuration (Render auto-generates SECRET_KEY if using render.yaml)
SECRET_KEY=generate-a-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth — get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# IMPORTANT: Update this to your Render backend URL after first deploy
GOOGLE_REDIRECT_URI=https://stocksage-india-backend.onrender.com/api/auth/google/callback

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=https://stocksageindia.vercel.app

# Market service (python -m market.service): Dhan feed -> Redis candles -> chart socket.
# Must run always-on (not a sleeping free tier). Uses the Dhan and Redis settings below.
MARKET_HOST=127.0.0.1
MARKET_PORT=8001
MARKET_HISTORY_DAYS=7

# Dhan market data (daily token: generate before 09:00, check with python -m scripts.check_dhan_token)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Redis: caching, rate limits, live candles and socket tickets
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=stocksage-local
